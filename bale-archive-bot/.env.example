# ─── بله ───
BALE_BOT_TOKEN=
BALE_API_BASE=https://tapi.bale.ai
RUN_MODE=polling
WEBHOOK_BASE_URL=
WEBHOOK_SECRET_PATH=
POLLING_IDLE_SLEEP=2.0
POLLING_BUSY_SLEEP=0.3

# ─── چت‌ها (اختیاری؛ با /start و «آرشیو» هم تنظیم می‌شود) ───
ARCHIVE_CHAT_ID=
ADMIN_CHAT_ID=
ADMIN_USER_IDS=
ALLOWED_GROUP_IDS=

# ─── رفتار ───
INGEST_MODE=hybrid
SUBMISSION_TTL_MINUTES=30
REMINDER_AFTER_MINUTES=10
EXPIRED_POLICY=republish
UNDO_WINDOW_MINUTES=10
PRIVATE_SUMMARY_TTL_SECONDS=30
ALBUM_WINDOW_MS=2500
IGNORE_STICKERS=true
FORMATTING_ENABLED=false

# ─── دیتابیس (یکی را باز بگذارید) ───
# SQL Server روی همین ویندوز (ODBC Driver 18):
DATABASE_URL=mssql+aioodbc://USER:PASSWORD@localhost:1433/bale_archive?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
# ورود ویندوز به‌جای کاربر SQL:
# DATABASE_URL=mssql+aioodbc://@localhost/bale_archive?driver=ODBC+Driver+18+for+SQL+Server&Trusted_Connection=yes&TrustServerCertificate=yes
# PostgreSQL جایگزین:
# DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/bale_archive
# SQLite فقط برای تست:
# DATABASE_URL=sqlite+aiosqlite:///data/bot.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
STATE_BACKEND=postgres

# ─── فایل‌های رسانه روی دیسک همین ماشین ───
STORAGE_BACKEND=local
MEDIA_ROOT=data\media
MEDIA_DOWNLOAD_ENABLED=true
S3_MAX_DOWNLOAD_MB=20
# برای سوییچ بعدی به S3 فقط این‌ها را پر کنید و STORAGE_BACKEND=s3 بگذارید:
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_MEDIA=

# ─── محدودیت‌ها ───
RATE_GLOBAL_RPS=20
RATE_PER_CHAT_PER_SEC=1
RATE_PER_GROUP_PER_MIN=20
MAX_SUBMISSIONS_PER_USER_PER_HOUR=60
ADMIN_NOTIFY_BATCH_THRESHOLD=5

# ─── عملیات ───
LOG_LEVEL=INFO
LOG_FORMAT=console
SENTRY_DSN=
TZ=Asia/Tehran
METRICS_ENABLED=true
BACKUP_DIR=data\backups
SPOOL_DIR=data\spool
PYTHONUTF8=1
