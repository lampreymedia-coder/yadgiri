# ─── بله ───
BALE_BOT_TOKEN=
BALE_API_BASE=https://tapi.bale.ai
RUN_MODE=polling                    # polling | webhook
WEBHOOK_BASE_URL=
WEBHOOK_SECRET_PATH=
POLLING_IDLE_SLEEP=2.0
POLLING_BUSY_SLEEP=0.3

# ─── چت‌ها ───
ARCHIVE_CHAT_ID=
ADMIN_CHAT_ID=
ADMIN_USER_IDS=                     # با کاما جدا شود
ALLOWED_GROUP_IDS=                  # خالی = همه‌ی گروه‌هایی که ربات در آن‌هاست

# ─── رفتار ───
INGEST_MODE=hybrid                  # group_gateway | private_first | hybrid
SUBMISSION_TTL_MINUTES=30
REMINDER_AFTER_MINUTES=10
EXPIRED_POLICY=republish            # republish | auto_tag | keep_draft
UNDO_WINDOW_MINUTES=10
ALBUM_WINDOW_MS=2500
IGNORE_STICKERS=true
FORMATTING_ENABLED=false

# ─── دیتابیس ───
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/db?ssl=require
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# ─── Redis (اختیاری) ───
REDIS_URL=
STATE_BACKEND=auto                  # auto | redis | postgres

# ─── فضای ابری آروان ───
S3_ENDPOINT_URL=https://s3.ir-thr-at1.arvanstorage.ir
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_MEDIA=bale-archive-media
S3_BUCKET_BACKUP=bale-archive-backup
S3_MAX_DOWNLOAD_MB=20
MEDIA_DOWNLOAD_ENABLED=true

# ─── محدودیت‌ها ───
RATE_GLOBAL_RPS=20
RATE_PER_CHAT_PER_SEC=1
RATE_PER_GROUP_PER_MIN=20
MAX_SUBMISSIONS_PER_USER_PER_HOUR=60
ADMIN_NOTIFY_BATCH_THRESHOLD=5

# ─── عملیات ───
LOG_LEVEL=INFO
LOG_FORMAT=json
SENTRY_DSN=
TZ=Asia/Tehran
METRICS_ENABLED=true
